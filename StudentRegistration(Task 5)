<!DOCTYPE html>
<html>
<head>
    <title>Student Registration Form</title>
</head>
<body bgcolor="#f5f5f5">

<center>
    <table border="1" cellpadding="10" cellspacing="0" width="80%">
        <tr bgcolor="#cce6ff">
            <th colspan="3">
                <font color="darkred" size="7">
                    STUDENT REGISTRATION FORM
                </font><br>
                <font color="green" size="5">
                    Create your account and join with us!
                </font>
            </th>
        </tr>

        <tr bgcolor="#d9edf7">
            <th colspan="3" align="left">
                1. Personal Information
            </th>
        </tr>

        <tr>
            <td>Full Name</td>
            <td colspan="2"><input type="text" size="40"></td>
        </tr>

        <tr>
            <td>Email Address</td>
            <td colspan="2"><input type="email" size="40"></td>
        </tr>

        <tr>
            <td>Mobile Number</td>
            <td colspan="2"><input type="text" size="40"></td>
        </tr>

        <tr>
            <td>Date of Birth</td>
            <td colspan="2"><input type="date"></td>
        </tr>

        <tr>
            <td>Gender</td>
            <td colspan="2">
                <input type="radio" name="g"> Male
                <input type="radio" name="g"> Female
                <input type="radio" name="g"> Other
            </td>
        </tr>

        <tr>
            <td>Address</td>
            <td colspan="2">
                <textarea rows="4" cols="50"></textarea>
            </td>
        </tr>

        <tr bgcolor="#dff0d8">
            <th colspan="3" align="left">
                2. Education Details
            </th>
        </tr>

        <tr>
            <td>Courses Interested In</td>
            <td colspan="2">
                <input type="checkbox"> BCA
                <input type="checkbox"> B.Sc(CS)
                <input type="checkbox"> B.Com
                <input type="checkbox"> BBA
            </td>
        </tr>

        <tr>
            <td>Year of Study</td>
            <td colspan="2">
                <input type="radio" name="year"> 1st Year
                <input type="radio" name="year"> 2nd Year
                <input type="radio" name="year"> 3rd Year
                <input type="radio" name="year"> Final Year
            </td>
        </tr>

        <tr>
            <td>Department</td>
            <td colspan="2">
                <select>
                    <option>Select Department</option>
                    <option>Computer Science</option>
                    <option>Mathematics</option>
                    <option>Commerce</option>
                    <option>Physics</option>
                </select>
            </td>
        </tr>

        <tr bgcolor="#fcf8e3">
            <th colspan="3" align="left">
                3. Account Information
            </th>
        </tr>

        <tr>
            <td>Username</td>
            <td colspan="2"><input type="text" size="40"></td>
        </tr>

        <tr>
            <td>Password</td>
            <td colspan="2"><input type="password" size="40"></td>
        </tr>

        <tr>
            <td>Confirm Password</td>
            <td colspan="2"><input type="password" size="40"></td>
        </tr>

        <tr bgcolor="#f2dede">
            <th colspan="3" align="left">
                4. Upload & Other Details
            </th>
        </tr>

        <tr>
            <td>Upload Photo</td>
            <td colspan="2">
                <input type="file">
            </td>
        </tr>

        <tr>
            <td>How did you know about us?</td>
            <td colspan="2">
                <select>
                    <option>Select Option</option>
                    <option>Internet</option>
                    <option>Friend</option>
                    <option>Advertisement</option>
                </select>
            </td>
        </tr>

        <tr>
            <td>Additional Comments</td>
            <td colspan="2">
                <textarea rows="4" cols="50"></textarea>
            </td>
        </tr>

        <tr align="center">
            <td colspan="3">
                <input type="submit" value="Submit Registration">
                <input type="reset" value="Reset Form">
                <input type="button" value="Custom Button">
            </td>
        </tr>
    </table>
</center>

</body>
</html>
